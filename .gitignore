# Root .gitignore for combined repo

# Node
**/node_modules/
**/build/

# Java / Maven
**/target/
*.log

# IDEs
.vscode/
.idea/
*.iml

# Environment / Docker
.env
.env.local
.env.*.local
docker-compose.override.yml
docker-compose.*.yml

# Backend local secrets
ebank-backend/src/main/resources/application.properties
ebank-backend/src/main/resources/application.yaml

# Frontend local env
ebank-frontend/.env
ebank-frontend/.env.local
ebank-frontend/.env.development.local
ebank-frontend/.env.test.local
ebank-frontend/.env.production.local

# Ignore nested git metadata
**/.git
