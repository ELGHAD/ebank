# Copy to .env (git-ignored) and fill in the secrets. Never commit .env.
#   Linux/macOS: cp .env.example .env      Windows: copy .env.example .env

# PostgreSQL (container only; not published to the host)
POSTGRES_DB=ebank
# Schema owner, used only by Flyway migrations
POSTGRES_USER=ebank
POSTGRES_PASSWORD=
# Restricted role the application connects with (no DDL, no rewriting of ledger/audit history)
APP_DB_USER=ebank_app
APP_DB_PASSWORD=

# JWT signing key, at least 32 bytes. Generate with: openssl rand -hex 32
APP_JWT_SECRET=
APP_JWT_EXPIRATION=60m

# "demo" creates a demo agent account at startup (synthetic data only)
SPRING_PROFILES_ACTIVE=demo
DEMO_AGENT_USERNAME=agent@demo.ebank.test
# At least 12 characters
DEMO_AGENT_PASSWORD=
# Optional (12+ characters): also create the demo organization admin and the platform admin
DEMO_ORG_ADMIN_USERNAME=admin@demo.ebank.test
DEMO_ORG_ADMIN_PASSWORD=
DEMO_PLATFORM_ADMIN_USERNAME=platform@ebank.test
DEMO_PLATFORM_ADMIN_PASSWORD=

# Host port of the web application: http://localhost:3000
FRONTEND_PORT=3000
